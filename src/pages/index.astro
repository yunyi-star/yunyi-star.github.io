---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, getProjects, fmtDate as fmt } from '../lib/collections';
import ProjectCard from '../components/ProjectCard.astro';

const posts = (await getPosts()).slice(0, 6);
const projects = (await getProjects()).slice(0, 4);
---

<BaseLayout
  title="yunyi-star · 机器人与软件工程实践"
  description="移动机器人、社区巡检、工控通信、视觉路由与 Web 应用的项目档案和可交互示例。"
>
  <h1>把系统接起来，<br />把关键判断写清楚。</h1>
  <p class="lede">
    我是 yunyi-star。这里记录围绕机器人与软件系统做过的项目：
    从导航、视觉与机械臂的协作，到工控通信和模型工具接入。
    这里也保留具体的排障过程：为什么机械臂扫飞物块、雷达看见自己的车体、检测有框却数成零，以及每次修复是怎样验证的。
  </p>
  <div class="home-actions">
    <a class="primary-link" href="/projects/">查看项目档案</a>
    <a href="/lab/">体验两个交互演示</a>
  </div>

  <div class="section-head">
    <h2>项目档案</h2>
    <a href="/projects/">查看全部</a>
  </div>
  {
    projects.length === 0 ? (
      <p class="meta">项目档案正在整理。</p>
    ) : (
      projects.map((p) => (
        <ProjectCard project={p} />
      ))
    )
  }

  <div class="section-head">
    <h2>问题是怎样解决的</h2>
    <a href="/blog/">查看全部</a>
  </div>
  {
    posts.length === 0 ? (
      <p class="meta">工程复盘正在整理。</p>
    ) : (
      posts.map((post) => (
        <a class="card" href={`/blog/${post.id}/`}>
          <p class="card-title">{post.data.title}</p>
          <p class="card-sum">
            <span class="meta">{fmt(post.data.date)}</span> — {post.data.summary}
          </p>
        </a>
      ))
    )
  }
</BaseLayout>
