---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, getProjects, fmtDate as fmt } from '../lib/collections';

const posts = (await getPosts()).slice(0, 5);
const projects = (await getProjects()).slice(0, 4);
---

<BaseLayout
  title="王余勃 · 机器人与工控安全"
  description="嵌入式、机器人系统、工控安全。把做过的东西和踩过的坑写清楚。"
>
  <h1>把机器人调通，也把过程写清楚</h1>
  <p class="lede">
    长江大学计算机科学与技术专业，2028 届。做嵌入式、机器人系统（ROS / SLAM /
    机械臂 / 视觉部署）和工控安全（PLC / 协议设计）。这里放项目档案和工程复盘。
  </p>

  <div class="section-head">
    <h2>项目档案</h2>
    <a href="/projects/">全部 →</a>
  </div>
  {
    projects.length === 0 ? (
      <p class="meta">还没有项目档案。往 src/content/projects/ 里放 .md 就会出现。</p>
    ) : (
      projects.map((p) => (
        <a class="card" href={`/projects/${p.id}/`}>
          <p class="card-title">{p.data.name}</p>
          <p class="card-sum">
            {p.data.role} · {p.data.year} · {p.data.status}
            {p.data.subtitle ? ` — ${p.data.subtitle}` : ''}
          </p>
        </a>
      ))
    )
  }

  <div class="section-head">
    <h2>最近写的</h2>
    <a href="/blog/">全部 →</a>
  </div>
  {
    posts.length === 0 ? (
      <p class="meta">还没有文章。往 src/content/blog/ 里放 .md 就会出现。</p>
    ) : (
      posts.map((post) => (
        <a class="card" href={`/blog/${post.id}/`}>
          <p class="card-title">{post.data.title}</p>
          <p class="card-sum">
            <span class="meta">{fmt(post.data.date)}</span> — {post.data.summary}
          </p>
        </a>
      ))
    )
  }
</BaseLayout>
