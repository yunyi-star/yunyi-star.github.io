---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, fmtDate as fmt } from '../../lib/collections';

const posts = await getPosts();
---

<BaseLayout title="工程复盘" description="从具体故障、排查证据与失败尝试，到修复和验证结果。">
  <h1>工程复盘</h1>
  <p class="lede">问题怎样出现，如何排查，哪些尝试失败了，最后改了什么。共 {posts.length} 篇。</p>

  {
    posts.map((post) => (
      <a class="card" href={`/blog/${post.id}/`}>
        <p class="card-title">{post.data.title}</p>
        <p class="card-sum">
          <span class="meta">{fmt(post.data.date)}</span> — {post.data.summary}
        </p>
        <p style="margin: 8px 0 0">
          {post.data.tags.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </p>
      </a>
    ))
  }
</BaseLayout>
